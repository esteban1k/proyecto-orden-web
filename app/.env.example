# Dev proxy target for `next dev` rewrites of /v1/* and /health.
# `next build` is a static export and does not apply rewrites.
# http is accepted only for localhost / 127.0.0.1.
API_PROXY_TARGET=http://localhost:8080

# Browser calls. Empty in dev (same-origin + rewrites).
# Set an https origin for a static build so the CSP can pin connect-src.
NEXT_PUBLIC_API_BASE_URL=

# Device label sent on register/login (optional)
NEXT_PUBLIC_DEVICE_LABEL=Lista Criolla Web
